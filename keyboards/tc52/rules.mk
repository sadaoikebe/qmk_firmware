# TC52 (TS52K capacitive / EC). Copied from tc69/rules.mk; MCU / BOOTLOADER / NKRO / encoder
# live in keyboard.json (generated by tools/gen_tc52.py).

# Full custom matrix, as TC69. QMK's debounce is NOT applied
# (matrix_scan() is TC69's function; "lite" would insert debounce()).
CUSTOM_MATRIX = yes
SRC += matrix.c

# Replaces ANALOG_ENABLE = yes + SRC += analog.c (also sets HAL_USE_ADC=TRUE).
ANALOG_DRIVER_REQUIRED = yes

# Raw-ADC diagnostics over the QMK console. Default OFF; the normal build is unaffected.
#   qmk compile -kb tc52 -km nicola -e TC52_ADC_DIAG=yes
TC52_ADC_DIAG ?= no
ifeq ($(strip $(TC52_ADC_DIAG)), yes)
    CONSOLE_ENABLE = yes
    OPT_DEFS += -DTC52_ADC_DIAG
endif
